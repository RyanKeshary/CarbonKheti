# CarbonKheti Environment Configuration
# Copy this file to .env and adjust variables as required.

# Environment Mode: 'sandbox' or 'production'
# In 'production', all sandbox flags, seeds, and simulations are strictly forbidden.
APP_ENV=sandbox

# Secret Key for JWT Signing (Must be cryptographically strong in production)
JWT_SECRET=sandbox_jwt_secret_key_change_in_production_min32chars!

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Database Connection (PostgreSQL 16 with PostGIS in production, SQLite for local testing)
DATABASE_URL=sqlite:///./data/carbonkheti.db

# Groq Cloud API Key for Multilingual Agronomy LLM (Server-side only; never in client/repo)
GROQ_API_KEY=

# Open Exchange Rates API Key (Optional; fallback to Open API if empty)
OPEN_EXCHANGE_RATES_APP_ID=

# Razorpay / Cashfree Merchant Credentials (Production payout & escrow rails)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# DLT Registered SMS Provider (Karix / Gupshup / ValueFirst)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=CRBKHT

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Redis Cache & Background Task Broker (Optional in local development)
REDIS_URL=redis://localhost:6379/0

# DPDP Act 2023 Statutory Contacts
DPO_EMAIL=dpo@carbonkheti.org
GRIEVANCE_OFFICER_EMAIL=grievance@carbonkheti.org
