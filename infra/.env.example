# ==============================================================================
# CarbonKheti Environment Configuration (.env.example)
# In accordance with Section 8.1 & Section 10:
# List every variable with a description. Never commit real keys or secrets.
# ==============================================================================

# Database Configuration (PostgreSQL 16 + PostGIS)
# Default for Docker: postgresql+asyncpg://carbonkheti:password@db:5432/carbonkheti
# If left empty, API falls back automatically to local async SQLite.
DATABASE_URL=postgresql+asyncpg://carbonkheti:secure_dev_password@localhost:5432/carbonkheti

# Redis Task Queue & Caching URL
REDIS_URL=redis://localhost:6379/0

# Groq LLM API Key (Section 8.1: Server-side environment variable only)
# Used for grounded farmer agronomy RAG, plain-language contract explainer, and auditor assistant.
# Dynamic model discovery queries available models automatically at startup.
GROQ_API_KEY=

# Banking & Payout Rails (Razorpay X / Cashfree Payouts)
# Used for beneficiary penny-drop account validation (₹1.00) and staged integer-paise farmer payouts.
# When empty, payouts are labelled honestly as "AWAITING_BANK_API_APPROVAL".
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Satellite Data Access (Copernicus Data Space Ecosystem)
# Free open-access tier for Sentinel-1 GRD SAR and Sentinel-2 L2A optical time series.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# NASA FIRMS (Fire Information for Resource Management System)
# Free open-access MAP_KEY for near real-time VIIRS 375m active fire hotspot checking.
NASA_FIRMS_MAP_KEY=

# Server Runtime Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
